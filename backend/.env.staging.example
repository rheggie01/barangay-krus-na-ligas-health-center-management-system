APP_NAME=Barangay Health Center Management System
APP_ENV=staging
DEBUG=false

API_V1_PREFIX=/api/v1

DATABASE_HOST=your_cloud_database_host
DATABASE_PORT=3306
DATABASE_NAME=barangay_health_db
DATABASE_USER=your_cloud_database_user
DATABASE_PASSWORD=your_cloud_database_password

FRONTEND_URL=https://your-frontend-domain.example
BACKEND_CORS_ORIGINS=https://your-frontend-domain.example

JWT_SECRET_KEY=replace_with_a_long_random_secret
